\name{sarem_filters}
\alias{sarem_filters}
\alias{sarem_orders}
\alias{sarem_families}
\title{List filters available from CMA-SAREM}
\usage{
sarem_filters(order = NULL)

sarem_orders()

sarem_families(order = NULL)
}
\arguments{
\item{order}{Optional taxonomic order used to obtain its families.}
}
\value{\code{sarem_filters()} returns a named list. The convenience functions
return character vectors.}
\description{Lists orders, families, categories, range types, and map layers
available for queries.}

